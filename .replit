modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
PORTAL_DEMO_MODE = "true"
VITE_PORTAL_DEMO_MODE = "true"
DEV_DEMO_LOGIN_ENABLED = "true"
VITE_DEV_DEMO_LOGIN_ENABLED = "true"

[userenv.production]
PUBLIC_TEST_LOGIN_ENABLED = "true"
VITE_PUBLIC_TEST_LOGIN_ENABLED = "true"

[userenv.shared]
PUBLIC_OPPORTUNITIES_URL = "https://1855d08d-cc88-438a-8a7e-143ea6035cf2-00-nsg3rj7o9kp5.spock.replit.dev/larkin2-opportunities/"
CONTACT_ENQUIRY_FROM = "admin@hetvopportunities.com"
CONTACT_ENQUIRY_TO = "admin@hetvopportunities.com"
EMAIL_ADMIN_FROM = "admin@hetvopportunities.com"
EMAIL_ADMIN_TO = "admin@hetvopportunities.com"
PUBLICATION_EMAIL_FROM = "admin@hetvopportunities.com"
RESEND_ACCOUNT_ID = "hetv-primary-resend"
STAFF_AUTH_FROM = "admin@hetvopportunities.com"
SUBSCRIPTION_VERIFICATION_FROM = "admin@hetvopportunities.com"
PUBLICATION_TEST_EMAIL = "dev@gentraxtech.com"
EMAIL_WORKERS_ENABLED = "true"
PUBLICATION_ALERTS_ACTIVATED_AT = "2026-11-10T17:30:54.952Z"
PUBLICATION_EMAIL_APPROVED = "true"
PUBLICATION_EMAIL_MODE = "live"
STAFF_AUTH_ORIGIN = "https://1855d08d-cc88-438a-8a7e-143ea6035cf2-00-nsg3rj7o9kp5.spock.replit.dev"
