modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
PORTAL_DEMO_MODE = "true"
VITE_PORTAL_DEMO_MODE = "true"
PUBLICATION_EMAIL_FROM = "hetv@gentraxtech.com"
PUBLICATION_TEST_EMAIL = "n.o.lamptey12@gmail.com"
DEV_DEMO_LOGIN_ENABLED = "true"
VITE_DEV_DEMO_LOGIN_ENABLED = "true"

[userenv.production]
PUBLIC_TEST_LOGIN_ENABLED = "true"
VITE_PUBLIC_TEST_LOGIN_ENABLED = "true"

[userenv.shared]
PUBLIC_OPPORTUNITIES_URL = "https://larkin2opportunities.gentraxtech.com/larkin2-opportunities/"
