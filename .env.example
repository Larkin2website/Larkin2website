# Copy to .env at the REPOSITORY ROOT, or set in the hosting secret manager.
# These are placeholders, NOT credentials. Never commit your real .env.
# Injected hosting environment variables override .env values. Restart after changes.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Stable non-secret identifier for the intended Resend team/account.
# Keep it unchanged for key rotation; use a new ID when moving to another account.
RESEND_ACCOUNT_ID=

# Explicit approved senders on Resend-verified domains; no developer sender fallback.
# Contact FROM/TO must be bare email addresses (no display name).
CONTACT_ENQUIRY_FROM=
CONTACT_ENQUIRY_TO=admin@HETVopportunities.com
# Verification/publication FROM accept bare email or Name <email>.
SUBSCRIPTION_VERIFICATION_FROM=
PUBLICATION_EMAIL_FROM=
# Include the public artifact prefix, e.g. https://your-domain/larkin2-opportunities/
PUBLIC_OPPORTUNITIES_URL=
PUBLICATION_TEST_EMAIL=

# Explicit approved warning sender, bare email or Name <email>.
# No warning emails send without this value. The CRM warning still works.
EMAIL_ADMIN_FROM=
EMAIL_ADMIN_TO=admin@HETVopportunities.com
# Warning threshold; all reserves apply to daily AND monthly capacity.
EMAIL_WARNING_PERCENT=80
EMAIL_ADMIN_RESERVE=1
EMAIL_TRANSACTIONAL_RESERVE=5

# SAFE DEFAULTS: do not enable subscriber sending without separate approval.
PUBLICATION_EMAIL_MODE=off
PUBLICATION_EMAIL_APPROVED=false
PUBLICATION_ALERTS_ACTIVATED_AT=
# Existing verification-signing secret. Preserve securely or expire existing codes.
SESSION_SECRET=

# Database/auth/runtime settings are provided separately by your hosting.
# This email example does not configure or migrate database/Clerk.
